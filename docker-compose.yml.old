services:
  # TimescaleDB (PostgreSQL) service
  timescaledb:
    image: timescale/timescaledb:latest-pg15
    #build: ./db
    container_name: perocube-postgres
    ports:
      - "${DB_PORT}:5432"
    environment:
      - POSTGRES_DB=${DB_NAME:-perocube}
      - POSTGRES_USER=${DB_USER:-postgres}
      - POSTGRES_PASSWORD=${DB_PASSWORD}
    volumes:
      - postgres-data:/var/lib/postgresql/data
      - ./db/scripts:/scripts
      - ./db/sql:/sql
      # following line not needed when using the Dockerfile in db/
      - ./db/sql/schema:/docker-entrypoint-initdb.d
    restart: unless-stopped
    healthcheck:
      test: [ "CMD-SHELL", "pg_isready -U ${DB_USER:-postgres} -d ${DB_NAME:-perocube}" ]
      interval: 30s
      timeout: 30s
      retries: 3
      start_period: 5s
    deploy:
      resources:
        limits:
          memory: 2G
        reservations:
          memory: 1G
    networks:
      - perocube-network

  # Flyway service for database migrations
  flyway:
    image: flyway/flyway:11-alpine
    container_name: perocube-flyway
    command: -url=jdbc:postgresql://timescaledb:5432/${DB_NAME:-perocube} -user=${DB_USER:-postgres} -password=${DB_PASSWORD} -connectRetries=60 migrate
    volumes:
      - ./db/migrations:/flyway/sql
    depends_on:
      timescaledb:
        condition: service_healthy
    networks:
      - perocube-network

  # JupyterHub service
  jupyterhub:
    # image: jupyter/datascience-notebook:latest
    #build: ./jupyter
    image: ghcr.io/paolog8/perocube-jupyter:latest
    container_name: perocube-jupyter
    user: root
    environment:
      - JUPYTER_TOKEN=${JUPYTER_TOKEN:-jupytertoken} # Set this in .env file
      - POSTGRES_HOST=timescaledb
      - POSTGRES_DB=${DB_NAME:-perocube}
      - POSTGRES_USER=${DB_USER:-postgres}
      - POSTGRES_PASSWORD=${DB_PASSWORD}
      - POSTGRES_PORT=${DB_PORT:-5432}
    ports:
      - "8888:8888" # Jupyter port
      - "8866:8866" # Voilà port
    volumes:
      - jupyter-data:/home/jovyan/work
      - ./notebooks:/home/jovyan/notebooks
      - ./sample_data:/home/jovyan/sample_data
    depends_on:
      timescaledb:
        condition: service_healthy
    restart: unless-stopped
    command:
      - start-notebook.sh
      - --NotebookApp.token=${JUPYTER_TOKEN:-jupytertoken}
      #>
      #bash -c "pip install voila ipywidgets &&
    networks:
      - perocube-network
  # Voilà dashboards will run through the Jupyter service
  # You can access any notebook as a dashboard via:
  # http://localhost:8888/voila/render/notebooks/YourNotebook.ipynb

  # Grafana service for dashboards
  grafana:
    image: grafana/grafana-oss:latest
    container_name: perocube-grafana
    ports:
      - "3000:3000"
    environment:
      GF_SECURITY_ADMIN_PASSWORD: ${GRAFANA_PASSWORD:-admin}
      GF_INSTALL_PLUGINS: grafana-clock-panel,grafana-simple-json-datasource
      # Pass DB credentials for provisioning interpolation
      DB_NAME: ${DB_NAME:-perocube}
      DB_USER: ${DB_USER:-postgres}
      DB_PASSWORD: ${DB_PASSWORD}
    volumes:
      - grafana-data:/var/lib/grafana
      - ./grafana/provisioning:/etc/grafana/provisioning
    depends_on:
      timescaledb:
        condition: service_healthy
    networks:
      - perocube-network

  # Streamlit App for Metadata Ingestion
  streamlit:
    build: .
    container_name: perocube-streamlit
    ports:
      - "8501:8501"
    environment:
      - DB_HOST=timescaledb
      - DB_NAME=${DB_NAME:-perocube}
      - DB_USER=${DB_USER:-postgres}
      - DB_PASSWORD=${DB_PASSWORD}
      - DB_PORT=${DB_PORT:-5432}
    depends_on:
      timescaledb:
        condition: service_healthy
    networks:
      - perocube-network

  # Cloud TimescaleDB
  timescaledb-cloud:
    image: timescale/timescaledb:latest-pg15
    container_name: perocube-postgres-cloud
    ports:
      - "${DB_CLOUD_PORT:-5433}:5432"
    environment:
      - POSTGRES_DB=${DB_NAME:-perocube}
      - POSTGRES_USER=${DB_USER:-postgres}
      - POSTGRES_PASSWORD=${DB_PASSWORD}
    volumes:
      - postgres-cloud-data:/var/lib/postgresql/data
    restart: unless-stopped
    healthcheck:
      test: [ "CMD-SHELL", "pg_isready -U ${DB_USER:-postgres} -d ${DB_NAME:-perocube}" ]
      interval: 30s
      timeout: 30s
      retries: 3
      start_period: 5s
    deploy:
      resources:
        limits:
          memory: 2G
        reservations:
          memory: 1G
    networks:
      - perocube-network

  # Flyway for Cloud DB (App Schema)
  flyway-cloud:
    image: flyway/flyway:11-alpine
    container_name: perocube-flyway-cloud
    command: -url=jdbc:postgresql://timescaledb-cloud:5432/${DB_NAME:-perocube} -user=${DB_USER:-postgres} -password=${DB_PASSWORD} -connectRetries=60 -locations=filesystem:/flyway/sql migrate
    volumes:
      - ./db/migrations:/flyway/sql
    depends_on:
      timescaledb-cloud:
        condition: service_healthy
    networks:
      - perocube-network

  # SymmetricDS Edge
  symmetricds-edge:
    image: jumpmind/symmetricds:latest
    container_name: perocube-symmetricds-edge
    ports:
      - "31415:31415"
      - "8081:8080"
    environment:
      - ENGINE_NAME=edge-001
      - DB_PASSWORD=${DB_PASSWORD}
    volumes:
      - ./symmetricds/engines/edge.properties:/opt/symmetric-ds/engines/edge-001.properties
    depends_on:
      timescaledb:
        condition: service_healthy
      symmetricds-cloud:
        condition: service_healthy
    networks:
      - perocube-network

  # SymmetricDS Cloud
  symmetricds-cloud:
    image: jumpmind/symmetricds:latest
    container_name: perocube-symmetricds-cloud
    ports:
      - "31416:31415"
    environment:
      - ENGINE_NAME=cloud-000
      - DB_PASSWORD=${DB_PASSWORD}
    volumes:
      - ./symmetricds/engines/cloud.properties:/opt/symmetric-ds/engines/cloud-000.properties
    depends_on:
      timescaledb-cloud:
        condition: service_healthy
      flyway-cloud:
        condition: service_completed_successfully
    healthcheck:
      test: [ "CMD-SHELL", "nc -z 127.0.0.1 31415 || exit 1" ]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 20s
    networks:
      - perocube-network

  # Flyway for SymmetricDS Config
  flyway-sym-config:
    image: flyway/flyway:11-alpine
    container_name: perocube-flyway-sym-config
    command:
      - -url=jdbc:postgresql://timescaledb-cloud:5432/${DB_NAME:-perocube}
      - -user=${DB_USER:-postgres}
      - -password=${DB_PASSWORD}
      - -connectRetries=60
      - -locations=filesystem:/flyway/sym_sql
      - -table=flyway_schema_history_sym
      - -baselineOnMigrate=true
      - migrate
    volumes:
      - ./symmetricds/sql:/flyway/sym_sql
    depends_on:
      symmetricds-cloud:
        condition: service_healthy
    networks:
      - perocube-network

volumes:
  postgres-data:
    driver: local
  jupyter-data:
    driver: local
  grafana-data:
    driver: local
  postgres-cloud-data:
    driver: local

networks:
  perocube-network:
    driver: bridge
