    {
      "id": 8,
      "title": "Active Connections",
      "description": "All slots currently in a connection state with latest measurement values",
      "type": "table",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "postgres",
        "uid": "ffk21zlrlrqioe"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ffk21zlrlrqioe"
          },
          "rawSql": "SELECT\n  t.name                          AS \"Tracker\",\n  s.slot_code                     AS \"Slot\",\n  sc.name                         AS \"Cell\",\n  mcm.code                        AS \"Mode\",\n  COALESCE(mp.code, '—')          AS \"Polarity\",\n  mce.occurred_at                 AS \"Connected Since\",\n  $__timeTo() - mce.occurred_at   AS \"Duration\",\n  ROUND(m.power::numeric,   2)    AS \"Power (mW)\",\n  ROUND(m.voltage::numeric, 3)    AS \"Voltage (V)\",\n  ROUND(m.current::numeric, 4)    AS \"Current (mA)\"\nFROM (\n  SELECT DISTINCT ON (mpp_tracking_slot_id)\n    mpp_tracking_slot_id, solar_cell_id, mode_id, polarity_id, occurred_at, event_type\n  FROM mpp_connection_event\n  WHERE occurred_at <= $__timeTo()\n  ORDER BY mpp_tracking_slot_id, occurred_at DESC\n) mce\nJOIN mpp_tracking_slot   s   ON s.id   = mce.mpp_tracking_slot_id\nJOIN mpp_tracker         t   ON t.id   = s.mpp_tracker_id\nJOIN solar_cell          sc  ON sc.id  = mce.solar_cell_id\nJOIN mpp_connection_mode mcm ON mcm.id = mce.mode_id\nLEFT JOIN mpp_polarity   mp  ON mp.id  = mce.polarity_id\nJOIN LATERAL (\n  SELECT power, voltage, current\n  FROM mpp_measurement\n  WHERE mpp_tracking_slot_id = mce.mpp_tracking_slot_id\n    AND time <= $__timeTo()\n  ORDER BY time DESC LIMIT 1\n) m ON true\nWHERE mce.event_type = 'connection'\nORDER BY t.name, s.slot_code",
          "format": "table"
        }
      ],
