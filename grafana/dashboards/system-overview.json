      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ffk21zlrlrqioe"
          },
          "rawSql": "SELECT\n  time_bucket('5 minutes', time) AS time,\n  SUM(power) AS \"Total Power\"\nFROM mpp_measurement\nWHERE $__timeFilter(time)\nGROUP BY 1\nORDER BY 1",
