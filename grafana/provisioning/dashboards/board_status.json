                    "rawSql": "SELECT\n  board_number,\n  MAX(CASE WHEN channel_number = 1 THEN is_active ELSE 0 END) AS \"1\",\n  MAX(CASE WHEN channel_number = 2 THEN is_active ELSE 0 END) AS \"2\",\n  MAX(CASE WHEN channel_number = 3 THEN is_active ELSE 0 END) AS \"3\",\n  MAX(CASE WHEN channel_number = 4 THEN is_active ELSE 0 END) AS \"4\",\n  MAX(CASE WHEN channel_number = 5 THEN is_active ELSE 0 END) AS \"5\",\n  MAX(CASE WHEN channel_number = 6 THEN is_active ELSE 0 END) AS \"6\",\n  MAX(CASE WHEN channel_number = 7 THEN is_active ELSE 0 END) AS \"7\",\n  MAX(CASE WHEN channel_number = 8 THEN is_active ELSE 0 END) AS \"8\",\n  MAX(CASE WHEN channel_number = 9 THEN is_active ELSE 0 END) AS \"9\",\n  MAX(CASE WHEN channel_number = 10 THEN is_active ELSE 0 END) AS \"10\",\n  MAX(CASE WHEN channel_number = 11 THEN is_active ELSE 0 END) AS \"11\",\n  MAX(CASE WHEN channel_number = 12 THEN is_active ELSE 0 END) AS \"12\",\n  MAX(CASE WHEN channel_number = 13 THEN is_active ELSE 0 END) AS \"13\",\n  MAX(CASE WHEN channel_number = 14 THEN is_active ELSE 0 END) AS \"14\",\n  MAX(CASE WHEN channel_number = 15 THEN is_active ELSE 0 END) AS \"15\",\n  MAX(CASE WHEN channel_number = 16 THEN is_active ELSE 0 END) AS \"16\",\n  MAX(CASE WHEN channel_number = 17 THEN is_active ELSE 0 END) AS \"17\",\n  MAX(CASE WHEN channel_number = 18 THEN is_active ELSE 0 END) AS \"18\",\n  MAX(CASE WHEN channel_number = 19 THEN is_active ELSE 0 END) AS \"19\",\n  MAX(CASE WHEN channel_number = 20 THEN is_active ELSE 0 END) AS \"20\",\n  MAX(CASE WHEN channel_number = 21 THEN is_active ELSE 0 END) AS \"21\",\n  MAX(CASE WHEN channel_number = 22 THEN is_active ELSE 0 END) AS \"22\",\n  MAX(CASE WHEN channel_number = 23 THEN is_active ELSE 0 END) AS \"23\",\n  MAX(CASE WHEN channel_number = 24 THEN is_active ELSE 0 END) AS \"24\"\nFROM get_board_connection_status($__timeTo())\nGROUP BY board_number\nORDER BY board_number"
                }
