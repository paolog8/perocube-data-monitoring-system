            "targets": [
                {
                    "datasource": {
                        "type": "postgres",
                        "uid": "perocube-timescaledb"
                    },
                    "editorMode": "code",
                    "format": "table",
                    "rawQuery": true,
                    "refId": "A",
                    "sql": {
                        "columns": [
                            {
                                "parameters": [],
                                "type": "function"
                            }
                        ],
                        "groupBy": [
                            {
                                "property": {
                                    "type": "string"
                                },
                                "type": "groupBy"
                            }
                        ],
                        "limit": 50
                    },
                    "rawSql": "WITH mpp AS (\n  SELECT\n    time_bucket('1 minute', \"timestamp\") AS time,\n    AVG(current) as current,\n    AVG(voltage) as voltage,\n    AVG(power) as power\n  FROM get_mpp_data_for_pixel('$solar_cell', '$pixel')\n  WHERE $__timeFilter(\"timestamp\")\n  GROUP BY 1\n),\ntemp AS (\n  SELECT\n    time_bucket('1 minute', \"timestamp\") AS time,\n    AVG(temperature) as temperature\n  FROM temperature_measurement tm\n  JOIN temperature_sensor ts ON tm.temperature_sensor_id = ts.temperature_sensor_id\n  WHERE ts.sensor_identifier = '$temp_sensor' AND $__timeFilter(\"timestamp\")\n  GROUP BY 1\n),\nirr AS (\n  SELECT\n    time_bucket('1 minute', \"timestamp\") AS time,\n    AVG(irradiance) as irradiance\n  FROM irradiance_measurement im\n  JOIN irradiance_sensor isen ON im.irradiance_sensor_id = isen.irradiance_sensor_id\n  WHERE isen.sensor_identifier = '$irr_sensor' AND $__timeFilter(\"timestamp\")\n  GROUP BY 1\n)\nSELECT\n  COALESCE(mpp.time, temp.time, irr.time) AS \"time\",\n  mpp.current,\n  mpp.voltage,\n  mpp.power,\n  temp.temperature,\n  irr.irradiance\nFROM mpp\nFULL OUTER JOIN temp ON mpp.time = temp.time\nFULL OUTER JOIN irr ON COALESCE(mpp.time, temp.time) = irr.time\nORDER BY 1"
                }
            ],
            "title": "Data Export (1-minute averages)",
            "type": "table"
        }
